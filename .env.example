# =============================================================================
# WikiPulse configuration template.
# Copy this file to `.env` and adjust values as needed.
# Never commit a real `.env` file with secrets.
# =============================================================================

# ---- Wikimedia source -------------------------------------------------------
WIKIMEDIA_STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange
# Required by Wikimedia's User-Agent policy: https://meta.wikimedia.org/wiki/User-Agent_policy
WIKIMEDIA_USER_AGENT=WikiPulse/1.0 (b24cm1051@gmail.com) requests/2.32.3
# Comma-separated list of wiki dbnames to keep (empty = keep all)
WIKIMEDIA_WIKI_FILTER=enwiki
# Reconnect backoff (seconds)
SSE_RECONNECT_MIN_DELAY=1
SSE_RECONNECT_MAX_DELAY=60
SSE_RECONNECT_BACKOFF_FACTOR=2.0

# ---- Kafka -------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_EDITS=wikipedia-edits
KAFKA_TOPIC_DEAD_LETTER=wikipedia-edits-dlq
KAFKA_CONSUMER_GROUP=wikipulse-spark
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_LINGER_MS=50

# ---- Spark -------------------------------------------------------------------
SPARK_MASTER=local[*]
SPARK_APP_NAME=WikiPulseStreaming
SPARK_CHECKPOINT_DIR=./data/checkpoints
SPARK_WINDOW_DURATION=5 minutes
SPARK_SLIDE_DURATION=1 minute
SPARK_WATERMARK_DELAY=2 minutes
SPARK_TRIGGER_INTERVAL=30 seconds

# ---- Anomaly detection (median/MAD) ------------------------------------------
ANOMALY_MAD_THRESHOLD=3.5
ANOMALY_MIN_HISTORY_WINDOWS=8
ANOMALY_FALLBACK_EDIT_COUNT_THRESHOLD=15
ANOMALY_HISTORY_LOOKBACK_WINDOWS=48
ANOMALY_MAD_EPSILON=1e-6

# ---- Edit-war detection --------------------------------------------------------
EDIT_WAR_MUTUAL_REVERT_THRESHOLD=2
EDIT_WAR_MIN_EDITS_IN_WINDOW=4
EDIT_WAR_SCORE_MUTUAL_WEIGHT=2.0
EDIT_WAR_SCORE_BURST_WEIGHT=0.5
EDIT_WAR_FLAG_SCORE_THRESHOLD=3.0

# ---- Lift Wing enrichment -------------------------------------------------------
LIFTWING_ENABLED=false
LIFTWING_BASE_URL=https://api.wikimedia.org/service/lw/inference/v1/models
LIFTWING_MODEL_NAME=revertrisk-language-agnostic
LIFTWING_TIMEOUT_SECONDS=2.0
LIFTWING_MAX_RETRIES=1
LIFTWING_MAX_CONCURRENT_REQUESTS=4

# ---- PostgreSQL ----------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=wikipulse
POSTGRES_USER=wikipulse
POSTGRES_PASSWORD=wikipulse_dev_password
POSTGRES_RETENTION_DAYS=14

# ---- Parquet storage -------------------------------------------------------------
PARQUET_BASE_PATH=./data/parquet

# ---- Dashboard -------------------------------------------------------------------
DASHBOARD_REFRESH_SECONDS=10
DASHBOARD_RECENT_WINDOW_MINUTES=60

# ---- Logging -----------------------------------------------------------------
LOG_LEVEL=INFO
